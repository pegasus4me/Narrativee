# ─── Core ─────────────────────────────────────────────────────────────────────
PORT=3002
NODE_ENV=development
BACKEND_URL=http://localhost:3002
FRONTEND_URL=http://localhost:3000

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/narrativee
# LOCAL_DATABASE_URL=           # Optional: override for local dev

# ─── Auth (Better Auth) ──────────────────────────────────────────────────────
BETTER_AUTH_SECRET=                # Generate: openssl rand -hex 32
BETTER_AUTH_URL=http://localhost:3002

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Encryption ───────────────────────────────────────────────────────────────
ENCRYPTION_KEY=                    # 64 hex chars (32 bytes). Generate: openssl rand -hex 32

# ─── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=                 # sk_test_... (NEVER use sk_live_ in .env)
STRIPE_WEBHOOK_SECRET=             # whsec_...
# STRIPE_TEST_WEBHOOK_SECRET=      # For local Stripe CLI testing

# ─── LLM Providers ───────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
TYPESAFE_API_KEY=
GROK_API_KEY=                      # xAI API key
XAI_API_KEY=                       # Alternative xAI key

# ─── Social OAuth (Channels) ─────────────────────────────────────────────────
X_CLIENT_ID=
X_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# META_APP_ID=                     # Facebook
# META_APP_SECRET=
# INSTAGRAM_APP_ID=
# INSTAGRAM_APP_SECRET=
# THREADS_APP_ID=
# THREADS_APP_SECRET=

# ─── Services ────────────────────────────────────────────────────────────────
FIRECRAWL_API_KEY=
SCRAPECREATORS_API_KEY=            # Server-only Meta ad reference search
GOOGLE_FONTS_API_KEY=              # Google Fonts Developer API catalog
# Private image storage (Supabase Storage S3; server-only credentials).
# Create a PRIVATE bucket and copy its S3 endpoint, region and access keys from Supabase.
# Development saves to .data/brand-brain when all Supabase storage settings are absent.
# BRAND_BRAIN_LOCAL_DIR=           # Optional development storage directory
SUPABASE_STORAGE_ENDPOINT=        # https://PROJECT_REF.storage.supabase.co/storage/v1/s3
SUPABASE_STORAGE_REGION=          # Project region from the Supabase S3 configuration
SUPABASE_STORAGE_ACCESS_KEY_ID=
SUPABASE_STORAGE_SECRET_ACCESS_KEY=
SUPABASE_STORAGE_BUCKET=          # narrativee-images
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
RESEND_API_KEY=                    # For transactional emails
DISCORD_WAITLIST_WEBHOOK_URL=      # Server-only Discord webhook for new waitlist signups
PLACID_API_TOKEN=
PLACID_PUBLIC_TOKEN=
PLACID_INSTAGRAM_CAROUSEL_HOOK_TEMPLATE_ID=
PLACID_INSTAGRAM_CAROUSEL_INSIGHT_TEMPLATE_ID=
PLACID_INSTAGRAM_CAROUSEL_PROOF_TEMPLATE_ID=
PLACID_INSTAGRAM_CAROUSEL_CTA_TEMPLATE_ID=
PLACID_LINKEDIN_CAROUSEL_HOOK_TEMPLATE_ID=
PLACID_LINKEDIN_CAROUSEL_INSIGHT_TEMPLATE_ID=
PLACID_LINKEDIN_CAROUSEL_PROOF_TEMPLATE_ID=
PLACID_LINKEDIN_CAROUSEL_CTA_TEMPLATE_ID=

# ─── Deploy ──────────────────────────────────────────────────────────────────
# DEPLOY_HOOK_SECRET=              # Auth token for /api/deploy-hook
# DEPLOY_SCRIPT_PATH=/home/ubuntu/deploy.sh

# Billing launch (defaults to disabled until Stripe TEST flows and AI costs are verified).
BILLING_ENABLED=false
WEB_APP_URL=http://localhost:3010
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PORTAL_CONFIGURATION_ID=
BILLING_TEST_VERIFIED_AT=          # ISO timestamp after full Stripe test-mode validation
AI_COST_CHECKS_VERIFIED_AT=        # ISO timestamp after representative live-provider cost checks
# USD / million tokens. Each entry must include source, verifiedAt, version, kind,
# input, cachedInput, cacheWrite, output, maxInputTokens, maxOutputTokens.
# Image entries also need imageInput and imageCachedInput and a verified maximum
# output bound for one high-quality 1024x1024 image. Unconfigured models are blocked.
AI_MODEL_RATES_JSON={}
# Verified cost in integer microdollars for the fixed Firecrawl request contract.
# Configure firecrawl:scrapeHomepage and firecrawl:searchWeb from your provider terms.
# Each entry: {"microdollars": ..., "version": "...", "source": "https://...", "verifiedAt": "..."}
AI_TOOL_RATES_JSON={}
