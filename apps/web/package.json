{
  "name": "web",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "next build --webpack",
    "dev": "next dev -p 3010",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "check-types": "next typegen && tsc --noEmit",
    "test:ci": "TSX_TSCONFIG_PATH=tests/tsconfig.json node --import tsx --test --test-concurrency=1 tests/*.test.ts tests/*.test.tsx",
    "build:cloudflare": "opennextjs-cloudflare build"
  },
  "dependencies": {
    "@next/third-parties": "^16.0.6",
    "@opennextjs/cloudflare": "^1.20.10",
    "@radix-ui/react-dialog": "^1.1.15",
    "@tailwindcss/postcss": "^4.1.17",
    "@tanstack/react-query": "^5.100.11",
    "@victr/favicon-fetcher": "^4.0.1",
    "better-auth": "^1.4.3",
    "clsx": "^2.1.1",
    "fabric": "^7.4.0",
    "lucide-react": "^0.556.0",
    "markdown-to-jsx": "^9.1.1",
    "motion": "^12.23.24",
    "next": "^16.3.8",
    "posthog-js": "^1.374.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20251128.0",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^22.15.3",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "eslint": "^9.39.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.17",
    "tsx": "^4.20.6",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.2",
    "wrangler": "^4.51.0"
  }
}
