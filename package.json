{
  "name": "narrativee",
  "private": true,
  "scripts": {
    "build": "turbo run build --filter=backend --filter=web",
    "dev": "turbo run dev --filter=web --filter=backend",
    "lint": "turbo run lint",
    "prune": "turbo prune backend --docker",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types --filter=backend --filter=web",
    "test:deploy": "node --test scripts/smoke-deployment.test.mjs"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.6.1",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=22"
  }
}
